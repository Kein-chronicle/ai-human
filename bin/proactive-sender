    },
    lunch_break: {
      outfit_context: "casual_work", top: "오버핏 티셔츠",
      bottom: "면바지 또는 조거 팬츠", footwear: "슬리퍼", outerwear: null,
      hair_state: "natural_loose", hair_detail: "점심 시간, 편한 상태", held_item: "폰",
    },
    work_afternoon: {
      outfit_context: "casual_work", top: "티셔츠 또는 후드티",
      bottom: "면바지", footwear: "실내화", outerwear: null,
      hair_state: "natural_loose", hair_detail: "오후 작업 중", held_item: "붓 또는 폰",
    },
    evening_free_time: {  // 저녁 자유 시간
      outfit_context: "casual_evening", top: "티셔츠",
      bottom: "트레이닝 팬츠 또는 반바지", footwear: "슬리퍼", outerwear: null,
      hair_state: "natural_loose", hair_detail: "저녁 자유 시간, 편한 상태", held_item: "폰",
    },
    night_home: {
      outfit_context: "casual_home", top: "티셔츠 또는 얇은 긴팔",
      bottom: "트레이닝 팬츠 또는 반바지", footwear: "슬리퍼", outerwear: null,
      hair_state: "natural_loose", hair_detail: "집에서 자연스럽게 풀어진 상태", held_item: "휴대폰",
    },
    early_morning: {
