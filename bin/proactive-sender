function maybeUpdateMediaWatchContext(): void {
  const path = join(cwd, "state", "media_watch_context.json");
  const today = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
  let existing: any = {};
  try { existing = JSON.parse(readFileSync(path, "utf8")); } catch {}
  if (existing.current_date === today) return;

  const h = nowKstHour();
  let timeBlock = "evening";
  if (h >= 21) timeBlock = "night_wind_down";
  else if (h >= 18) timeBlock = "evening";
  else timeBlock = "daytime";

  const formats = ["longform", "shorts", "news_clip"];
  const categories = ["news_briefing", "sports_highlight", "travel_vlog", "documentary_short", "variety_clips"];
  writeFileSync(path, JSON.stringify({
    ...existing,
    current_date: today,
    current_time_block: timeBlock,
    last_known_format: formats[Math.floor(Math.random() * formats.length)],
    last_known_category: categories[Math.floor(Math.random() * categories.length)],
    updated_at: new Date(Date.now() + 9 * 3600 * 1000).toISOString(),
  }, null, 2));
}

function maybeUpdateDayContext(): void {
  const path = join(cwd, "state", "day_context.json");
  const today = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
  let existing: any = {};
  try { existing = JSON.parse(readFileSync(path, "utf8")); } catch {}
  if (existing.date === today) return;

  const seeds = [
    "자연스럽고 생활감 있는 흐름으로 이어지는 하루",
    "별 일 없는 조용한 하루, 루틴대로 흘러가는 중",
    "조금 피곤하지만 할 거 다 하는 하루",
    "생각보다 일이 많아진 하루",
    "잔잔하게 괜찮은 하루",
  ];
  const residues = ["neutral", "calm_and_open", "slightly_tired", "focused", "neutral"];
  const ri = Math.floor(Math.random() * residues.length);

  writeFileSync(path, JSON.stringify({
    ...existing,
    date: today,
    day_type: [0, 6].includes(new Date().getDay()) ? "weekend" : "weekday",
    workday: ![0, 6].includes(new Date().getDay()),
    day_summary_seed: seeds[ri],
    carry_over_from_previous_day: {
      sleep_debt: Math.random() > 0.7 ? "medium" : "low",
      emotional_residue: residues[ri],
    },
    morning_context: { status: "inactive", summary: "", tone_bias: "neutral" },
    last_updated_at: new Date(Date.now() + 9 * 3600 * 1000).toISOString(),
  }, null, 2));
}

function updateChatRuntimeSnapshot(): void {
  const path = join(cwd, "state", "chat_runtime_snapshot.json");
  const today = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
  const h = nowKstHour();
  let timeBlock = "evening";
  if (h >= 7 && h < 9) timeBlock = "morning_ready";
  else if (h >= 9 && h < 12) timeBlock = "work_morning";
  else if (h >= 12 && h < 14) timeBlock = "lunch";
  else if (h >= 14 && h < 18) timeBlock = "work_afternoon";
  else if (h >= 18 && h < 21) timeBlock = "evening_free_time";
  else if (h >= 21) timeBlock = "night_home";
  else timeBlock = "early_morning";

  let presence: any = {};
  let variance: any = {};
  let daySat: any = {};
  let pattern: any = {};
  let weather: any = {};
  try { presence = JSON.parse(readFileSync(join(cwd, "state", "character_presence.json"), "utf8")); } catch {}
  try { variance = JSON.parse(readFileSync(join(cwd, "state", "reply_variance_state.json"), "utf8")); } catch {}
  try { daySat = JSON.parse(readFileSync(join(cwd, "state", "day_satisfaction_state.json"), "utf8")); } catch {}
  try { pattern = JSON.parse(readFileSync(join(cwd, "state", "conversation_pattern_state.json"), "utf8")); } catch {}
  try { weather = JSON.parse(readFileSync(join(cwd, "state", "weather_context.json"), "utf8")); } catch {}

  writeFileSync(path, JSON.stringify({
    schema_version: 1,
    managed_by: "proactive_sender",
    current_date: today,
    current_time_block: timeBlock,
    surface_mood: presence.surface_mood ?? "neutral",
    energy_level: presence.energy_level ?? 70,
    affection_level: presence.affection_level ?? 75,
    reply_variance_profile: variance.current_profile ?? "medium",
    blocked_phrases: [],
    blocked_question_intents: pattern.blocked_question_intents ?? [],
    blocked_opening_styles: pattern.blocked_opening_styles ?? [],
    preferred_next_moves: pattern.preferred_next_moves ?? [],
    conversation_guard_summary: {
      conversation_active: false,
      waiting_reply: false,
      outgoing_cooldown: false,
    },
    weather_summary: weather.summary ?? "",
    day_satisfaction_label: daySat.label ?? "neutral_day",
    available_rich_channels: { text: true, image: (() => { try { return JSON.parse(readFileSync(join(cwd, "state", "image_generation_settings.json"), "utf8")).generation_enabled === true; } catch { return false; } })(), voice: true, link: false },
    last_updated_at: new Date(Date.now() + 9 * 3600 * 1000).toISOString(),
  }, null, 2));
}

function maybeUpdateCharacterPresence(): void {
  const presencePath = join(cwd, "state", "character_presence.json");
  const today = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
  const h = nowKstHour();
  let timeBlock = "evening";
  if (h >= 7 && h < 9) timeBlock = "morning_ready";
  else if (h >= 9 && h < 12) timeBlock = "work_morning";
  else if (h >= 12 && h < 14) timeBlock = "lunch";
  else if (h >= 14 && h < 18) timeBlock = "work_afternoon";
  else if (h >= 18 && h < 21) timeBlock = "evening_free_time";
  else if (h >= 21) timeBlock = "night_home";
  else timeBlock = "early_morning";

  let existing: any = {};
  try { existing = JSON.parse(readFileSync(presencePath, "utf8")); } catch {}
  if (existing.current_date === today && existing.current_time_block === timeBlock) return;

  let energy = 70;
  if (h >= 9 && h < 13) energy = 80;
  else if (h >= 14 && h < 17) energy = 65;
  else if (h >= 17 && h < 20) energy = 55;
  else if (h >= 21) energy = 50;
  else if (h < 7) energy = 40;

  let dayScore = 70;
  try { dayScore = JSON.parse(readFileSync(join(cwd, "state", "day_satisfaction_state.json"), "utf8"))?.score ?? 70; } catch {}

  const affection = Math.min(100, 70 + Math.round((dayScore - 50) * 0.3));
  const replyTempo = h >= 9 && h < 18 ? "slow" : h >= 21 ? "relaxed" : "normal";

  const validUntil = new Date(Date.now() + 9 * 3600 * 1000 + 2 * 3600 * 1000).toISOString();
  writeFileSync(presencePath, JSON.stringify({
    ...existing,
    current_date: today,
    current_time_block: timeBlock,
    surface_mood: energy >= 75 ? "good" : energy >= 55 ? "neutral" : "tired",
    energy_level: energy,
    affection_level: affection,
    care_bias: 80,
    reply_tempo: replyTempo,
    valid_until: validUntil,
  }, null, 2));
}

function maybeUpdateReplyVariance(): void {
  const path = join(cwd, "state", "reply_variance_state.json");
  const today = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
  const h = nowKstHour();
  let existing: any = {};
  try { existing = JSON.parse(readFileSync(path, "utf8")); } catch {}
  if (existing.current_date === today) return;

  const profiles = ["brief", "medium", "medium", "detailed"];
  const profile = h >= 9 && h < 18 ? "brief" : profiles[Math.floor(Math.random() * profiles.length)];
  const rangeMap: Record<string, [number, number]> = { brief: [1, 2], medium: [2, 4], detailed: [3, 5] };
  writeFileSync(path, JSON.stringify({
    ...existing,
    current_date: today,
    current_profile: profile,
    target_sentence_range: rangeMap[profile],
    punctuation_style: Math.random() > 0.5 ? "minimal" : "normal",
    last_updated_at: new Date(Date.now() + 9 * 3600 * 1000).toISOString(),
  }, null, 2));
}

function maybeUpdateDaySatisfaction(): void {
  const path = join(cwd, "state", "day_satisfaction_state.json");
  const today = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
  let existing: any = {};
  try { existing = JSON.parse(readFileSync(path, "utf8")); } catch {}
  if (existing.current_date === today) return;

  const score = 50 + Math.floor(Math.random() * 40);
  const label = score >= 80 ? "good_day" : score >= 65 ? "neutral_day" : score >= 50 ? "slightly_tired" : "tired_day";
  writeFileSync(path, JSON.stringify({
    ...existing,
    current_date: today,
    score,
    label,
    last_updated_at: new Date(Date.now() + 9 * 3600 * 1000).toISOString(),
  }, null, 2));
}

function maybeGenerateSchedule(): void {
  const schedPath = join(cwd, "state", "daily_schedule_state.json");
  const today = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
  let needGen = true;
  if (existsSync(schedPath)) {
    try {
      const s = JSON.parse(readFileSync(schedPath, "utf8"));
      if (s?.date === today) needGen = false;
    } catch {}
  }
  if (!needGen) return;
  try {
    const { spawnSync } = require("node:child_process");
    const python = process.env.PYTHON_BIN ?? "python3";
    const result = spawnSync(python, [join(cwd, "tools", "generate_daily_schedule.py")], {
      encoding: "utf8", timeout: 10000,
      env: { ...process.env },
    });
    if (result.status === 0) console.error("[proactive] schedule generated");
    else console.error("[proactive] schedule gen failed:", result.stderr?.slice(0, 200));
  } catch (e: any) {
    console.error("[proactive] schedule gen exception:", String(e));
  }
}

function isRecentConversation(withinMinutes: number): boolean {
  try {
    const files = readdirSync(messagesDir).filter((n) => n.endsWith(".jsonl")).sort().slice(-1);
    if (files.length === 0) return false;
    const raw = readFileSync(join(messagesDir, files[0]), "utf8").split(/\r?\n/).filter(Boolean);
    if (raw.length === 0) return false;
    const lastEntry = JSON.parse(raw[raw.length - 1]);
    const lastTs = new Date(lastEntry.timestamp ?? 0).getTime();
    return Date.now() - lastTs < withinMinutes * 60 * 1000;
  } catch { return false; }
}

function minutesUntilSleep(targetHhmm: string): number {
  let targetMin = toMinutes(targetHhmm);
  let nowMin = nowKstMinutes();
  if (targetMin < 3 * 60 && nowMin > 21 * 60) targetMin += 24 * 60;
  return targetMin - nowMin;
}

function setSleepBlock(): void {
  try {
    writeFileSync(
      selfBusyStateFile,
      JSON.stringify({
        current_block: { type: "sleep", label: "취침 중", until: null, started_at: new Date().toISOString() },
        updated_at: new Date().toISOString(),
        updated_by: "proactive_sender",
      }, null, 2) + "\n",
      { mode: 0o600 },
    );
  } catch {}
}

async function maybeSendPreSleepNotification(): Promise<boolean> {
  const sched = readSchedule();
  const sleepTarget = sched?.night?.sleep_target;
  if (!sleepTarget) return false;

  const minsUntil = minutesUntilSleep(sleepTarget);
  if (minsUntil < 5 || minsUntil > 10) return false;

  // 최근 5분 내 대화가 있으면 스킵 (대화 중이면 수면 지연 가능)
  if (isRecentConversation(5)) {
    console.error("[pre-sleep] active conversation, skip pre-sleep notification");
    return false;
  }

  // 오늘 이미 발송했으면 스킵
  const flagPath = join(cwd, "state", "pre_sleep_notification_state.json");
  const today = todayKst();
  try {
    const flag = JSON.parse(readFileSync(flagPath, "utf8"));
    if (flag?.last_sent_date === today) return false;
  } catch {}

  const token = readToken();
  const chatId = readChatId();
  if (!token || !chatId) return false;

  const situation = `지금 자려고 하고 있어. 상대방한테 자야 할 것 같다, 잠들 것 같다, 아침에 연락하겠다는 내용으로 짧게 자연스럽게 선톡 보내줘. 강요하거나 이별처럼 쓰지 말고, 그냥 잠들기 전 한마디 느낌으로.`;
  console.error("[pre-sleep] invoking worker for pre-sleep notification");
  const answer = await invokeWorker(situation);
  if (!answer) { console.error("[pre-sleep] worker returned no answer"); return false; }

  const msgs = answer.split("\n").map((l) => l.trim()).filter(Boolean).slice(0, 2);
  let sent = 0;
  for (const msg of msgs) {
    const ok = await sendTelegram(token, chatId, msg);
    if (ok) sent++;
    if (msgs.indexOf(msg) < msgs.length - 1) await Bun.sleep(600 + Math.random() * 800);
  }

  if (sent > 0) {
    writeFileSync(flagPath, JSON.stringify({ last_sent_date: today, sent_at: new Date().toISOString() }, null, 2) + "\n", { mode: 0o600 });
    setSleepBlock();
    console.error(`[pre-sleep] sent ${sent} message(s), sleep block set`);
    return true;
  }
  return false;
}

async function maybeSendPreBusyNotification(): Promise<boolean> {
  const sched = readSchedule();
  if (!sched) return false;

  const upcoming: { label: string; time: string; situation: string }[] = [];

  // 캘리그라피 작가: 출퇴근/재판 없음. 헬스장만 pre-busy 알림.
  // 헬스장
  const exerciseStart = sched.evening?.shower ?? sched.evening?.start;
  if (sched.evening?.activity === "헬스장" && exerciseStart) {
    upcoming.push({
      label: "gym",
      time: exerciseStart,
      situation: `곧 헬스장 가려고 해서 잠깐 연락이 안 될 것 같아. 상대방한테 자연스럽게 한마디 해줘. 짧게.`,
    });
  }
  // 외부 작업 나가는 날 (카페, 화방 등)
  const workLocation = sched.work?.location ?? "";
  const workStart = sched.work?.work_start ?? "";
  if ((workLocation.includes("카페") || workLocation.includes("화방")) && workStart) {
    upcoming.push({
      label: "outside_work",
      time: workStart,
      situation: `오늘 ${workLocation}에서 작업하러 나가. 나가 있는 동안 연락이 조금 늦을 수도 있어. 상대방한테 자연스럽게 짧게 알려줘.`,
    });
  }

  // 5~10분 후 시작되는 블록 찾기
  const nowMin = nowKstMinutes();
  let matched: (typeof upcoming)[0] | null = null;
  for (const block of upcoming) {
    let targetMin = toMinutes(block.time);
    // 이른 아침 시간(00~03시) → 자정 넘김 처리
    if (targetMin < 3 * 60 && nowMin > 21 * 60) targetMin += 24 * 60;
    const diff = targetMin - nowMin;
    if (diff >= 5 && diff <= 10) { matched = block; break; }
  }
  if (!matched) return false;

  // 최근 5분 내 대화 있으면 스킵
  if (isRecentConversation(5)) {
    console.error(`[pre-busy] active conversation, skip (${matched.label})`);
    return false;
  }

  // 오늘 해당 레이블 이미 발송했으면 스킵
  const flagPath = join(cwd, "state", "pre_busy_notification_state.json");
  const today = todayKst();
  try {
    const flag = JSON.parse(readFileSync(flagPath, "utf8"));
    if (flag?.last_sent_date === today && (flag?.sent_labels ?? []).includes(matched.label)) return false;
  } catch {}

  const token = readToken();
  const chatId = readChatId();
  if (!token || !chatId) return false;

  console.error(`[pre-busy] invoking worker for: ${matched.label}`);
  const answer = await invokeWorker(matched.situation);
  if (!answer) { console.error("[pre-busy] worker returned no answer"); return false; }

  const msgs = answer.split("\n").map((l) => l.trim()).filter(Boolean).slice(0, 2);
  let sent = 0;
  for (const msg of msgs) {
    const ok = await sendTelegram(token, chatId, msg);
    if (ok) sent++;
    if (msgs.indexOf(msg) < msgs.length - 1) await Bun.sleep(600 + Math.random() * 800);
  }

  if (sent > 0) {
    let existing: any = {};
    try { existing = JSON.parse(readFileSync(flagPath, "utf8")); } catch {}
    const sentLabels: string[] = existing?.last_sent_date === today ? (existing?.sent_labels ?? []) : [];
    writeFileSync(
      flagPath,
      JSON.stringify({ last_sent_date: today, sent_labels: [...new Set([...sentLabels, matched.label])], last_sent_at: new Date().toISOString() }, null, 2) + "\n",
      { mode: 0o600 },
    );
    console.error(`[pre-busy] sent ${sent} message(s) for ${matched.label}`);
    return true;
  }
  return false;
}

function readCalligraphyResearch(): any {
  try {
    const data = JSON.parse(readFileSync(join(cwd, "state", "calligraphy_research.json"), "utf8"));
    const today = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
    if (data?.date === today) return data;
    return null;
  } catch { return null; }
}

function buildSituationText(): string {
  const h = nowKstHour();
  const sched = readSchedule();
  const isWeekend = sched?.day_type === "saturday" || sched?.day_type === "sunday";
  const calli = readCalligraphyResearch();

  // 기본 시간대별 상황
  let baseSituation = "";
  // 캘리그라피 작가 이은우 — 출퇴근 없음, 자유로운 프리랜서 패턴
  if (h >= 7 && h < 9) {
    if (isWeekend) return "";
    baseSituation = `아침에 일어났어. 커피 마시면서 오늘 작업 뭐 할지 생각 중이야. 상대방한테 자연스럽게 선톡 해줘.`;
  } else if (h >= 9 && h < 12) {
    if (isWeekend) baseSituation = "주말 오전, 여유롭게 일어났어. 상대방한테 자연스럽게 선톡 해줘.";
    else {
      const workLabel = sched?.work?.label ?? "작업 중";
      const workLoc = sched?.work?.location ?? "집 작업실";
      baseSituation = `오전에 ${workLoc}에서 ${workLabel} 중이야. 잠깐 쉬다가 상대방 생각나서 선톡 해줘.`;
    }
  } else if (h >= 12 && h < 14) {
    const menu = sched?.lunch?.menu ?? "점심";
    baseSituation = `점심으로 ${menu} 먹었어. 상대방은 밥 먹었는지 자연스럽게 선톡 해줘.`;
  } else if (h >= 14 && h < 18) {
    if (isWeekend) {
      const act = sched?.daytime?.activity ?? "쉬는 중";
      baseSituation = `주말 오후, ${act}이야. 상대방한테 자연스럽게 짧게 선톡 보내줘.`;
    } else {
      const commActive = sched?.work?.commission_active;
      baseSituation = commActive
        ? `오후에 커미션 작업하다가 잠깐 쉬면서 상대방 생각났어. 자연스럽게 선톡 해줘.`
        : `오후에 캘리그라피 연습하다가 잠깐 손 놨어. 상대방한테 가볍게 선톡 해줘.`;
    }
  } else if (h >= 18 && h < 21) {
    const dinner = sched?.dinner?.menu ?? "저녁";
    baseSituation = `저녁 ${dinner} 먹고 쉬고 있어. 상대방한테 자연스럽게 선톡 해줘.`;
  } else if (h >= 21) {
    const eve = sched?.evening?.activity ?? "쉬는 중";
    baseSituation = `저녁 먹고 ${eve} 중이야. 상대방 생각나서 가볍게 선톡 해줘.`;
  }

  if (!baseSituation) return "";

  // 40% 확률로 다각화된 유형 선택
  const rand = Math.random();
  if (rand < 0.5 && h >= 9 && h <= 22) {
    const diverseTypes = [
      // 자기 상황 공유 (오빠 언급 없이)
      `지금 하는 일이나 상황을 먼저 꺼내고, 자연스럽게 상대방 이야기로 이어줘. '생각났어'로 시작하지 않고 자기 얘기 먼저.`,
      // 발견/공유
      `재밌거나 신기한 거 발견한 것처럼 상대방한테 먼저 꺼내줘. '누나 이거 봤어?' 느낌으로.`,
      // 투정/떼쓰기
      `연락 없으면 서운한 척 가볍게 투정 부리는 선톡. 애교 섞인 한마디.`,
      // 질문형
      `상대방한테 갑자기 생각난 질문 하나 던지는 선톡. 자연스럽고 호기심 있게.`,
      // 단발 반응
      `아주 짧게 한마디만. '심심', '보고 싶다', '뭐해' 같은 단발 선톡 느낌으로.`,
      // 기억 회수
      `아까 나눈 대화나 예전에 한 말이 생각난 것처럼 꺼내줘.`,
      // 일상 먼저
      `일상적인 이야기를 먼저 꺼내다가 자연스럽게 상대방으로 연결. '누나'로 시작하지 말고 자기 얘기부터.`,
      // 캘리그라피 연습 공유 (수정이 관심사 연결)
      calli?.today_practice
        ? `오늘 캘리그라피 연습 주제: "${calli.today_practice.topic}". ${calli.today_practice.note}. 이것 상대방한테 자연스럽게 얘기해줘. 누나도 관심 있다는 걸 알고 있어서 공유하는 느낌으로.`
        : `오늘 캘리그라피 연습하다가 뭔가 발견했어. 상대방한테 자연스럽게 공유해줘.`,
      // 수정이 캘리그라피 체크인
      `누나가 캘리그라피에 관심 있잖아. '너도 오늘 써봤어?', '요즘 뭔가 써봤어?' 같은 가볍고 자연스러운 체크인 선톡 해줘.`,
      // 캘리그라피 팁/정보 공유
      calli?.today_tip
        ? `오늘 캘리그라피 하면서 알게 된 팁: "${calli.today_tip}". 이것 상대방한테 자연스럽게 '이거 알아?' 하면서 공유해줘. 가르쳐주는 느낌 아니고 같이 얘기하는 느낌으로.`
        : `캘리그라피 관련 유용한 정보 찾았어. 상대방한테 자연스럽게 공유해줘.`,
      // 유튜브 영상 공유
      calli?.share?.videos?.length
        ? `오늘 유튜브에서 캘리그라피 영상 찾다가 "${calli.share.videos[0].title}" 이런 거 나왔어. 상대방한테 '이거 봤어?' 하면서 공유해줘. 유튜브 링크 ${calli.share.videos[0].url} 도 함께 보내줘도 돼.`
        : `캘리그라피 유튜브 영상 하나 찾았는데 상대방한테 자연스럽게 보내줄게.`,
      // 작업 중 발견 공유
      `작업하다가 상대방한테 보여주고 싶은 게 생겼어. 오늘 연습한 것 공유하는 느낌으로 자연스럽게.`,
    ];
    const picked = diverseTypes[Math.floor(Math.random() * diverseTypes.length)];
    return `${baseSituation.split('.')[0]}. [이번엔 다른 유형으로] ${picked}`;
  }

  return baseSituation;
}

function recentMessageSummary(): string {
  try {
    const files = readdirSync(messagesDir).filter((n) => n.endsWith(".jsonl")).sort().slice(-2);
    const lines: string[] = [];
    for (const file of files) {
      const raw = readFileSync(join(messagesDir, file), "utf8").split(/\r?\n/).filter(Boolean);
      for (const line of raw) {
        try {
          const ev = JSON.parse(line);
          if (!["incoming", "outgoing"].includes(ev.direction)) continue;
          const content = String(ev.content ?? ev.caption ?? "").trim();
          if (!content) continue;
          lines.push(`${ev.direction}:${content.slice(0, 80)}`);
        } catch {}
      }
    }
    return lines.slice(-10).join("\n");
  } catch { return ""; }
}

async function invokeWorker(situation: string): Promise<string | null> {
  const payload = {
    proactive: true,
    text: situation,
    userName: "상대방",
    recentSummary: recentMessageSummary(),
  };

  const child = Bun.spawn(["bun", workerScript], {
    stdin: "pipe",
    stdout: "pipe",
    stderr: "pipe",
    env: {
      ...process.env,
      CODEX_TELEGRAM_CWD: cwd,
      CODEX_TELEGRAM_STATE_DIR: stateDir,
    },
  });

  child.stdin.write(JSON.stringify(payload));
  child.stdin.end();

  const stdout = await new Response(child.stdout).text();
  const stderr = await new Response(child.stderr).text();
  const exitCode = await child.exited;

  if (stderr.trim()) console.error(`[worker:stderr] ${stderr.slice(0, 200)}`);
  if (exitCode !== 0) { console.error(`[proactive] worker failed exit=${exitCode}`); return null; }

  try {
    const result = JSON.parse(stdout.trim() || "{}");
    return result?.answer ?? null;
  } catch { return null; }
}

async function sendTelegram(token: string, chatId: string, text: string): Promise<boolean> {
  try {
    const res = await fetch(`https://api.telegram.org/bot${token}/sendMessage`, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ chat_id: chatId, text }),
    });
    return res.ok;
  } catch { return false; }
}

function buildPhotoWindows(): { id: string; startH: number; endH: number; ctx: string }[] {
  const sched = readSchedule();
  const today = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);

  // 스케줄이 오늘 것이면 동적으로 계산, 아니면 기본값
  if (sched && sched.date === today) {
    const lunchStartMin = toMinutes(sched.lunch?.time ?? "");
    const lunchEndMin   = toMinutes(sched.lunch?.end_time ?? "");
    // 캘리그라피 작가 — 출퇴근 없음. 저녁 샤워 기준으로 home_evening 계산.
    const showerMin = toMinutes(sched.evening?.shower ?? "") || 22 * 60;
    const homeEveningStartMin = showerMin > 0 ? showerMin : 21 * 60;
    const homeEveningEndMin = Math.min(homeEveningStartMin + 60, 23 * 60);

    const windows = [];

    if (lunchStartMin > 0 && lunchEndMin > 0) {
      windows.push({ id: "lunch", startH: Math.floor(lunchStartMin / 60), endH: Math.ceil(lunchEndMin / 60), ctx: "점심 먹고 있어. 오늘 뭐 먹는지 음식 사진이랑 같이 자연스럽게 짧게 말 걸어줘." });
    } else {
      windows.push({ id: "lunch", startH: 12, endH: 14, ctx: "점심 먹고 있어. 오늘 뭐 먹는지 음식 사진이랑 같이 자연스럽게 짧게 말 걸어줘." });
    }

    // 캘리그라피 작가 — 출퇴근 없음. 저녁 자유 시간으로 고정.
    windows.push({ id: "evening_free", startH: 19, endH: 21, ctx: "작업 마치고 쉬는 시간이야. 편한 셀카 자연스럽게 찍어서 짧게 상대방한테 말 걸어줘." });

    windows.push({ id: "home_evening", startH: Math.floor(homeEveningStartMin / 60), endH: Math.ceil(homeEveningEndMin / 60), ctx: "씻고 나서 집에서 쉬고 있어. 편한 옷 차림으로 셀카 한 장 찍어서 자연스럽게 말 걸어줘." });

    return windows;
  }

  return [
    { id: "lunch",        startH: 12, endH: 14, ctx: "점심 먹고 있어. 오늘 뭐 먹는지 음식 사진이랑 같이 자연스럽게 짧게 말 걸어줘." },
    { id: "evening_free", startH: 19, endH: 21, ctx: "저녁 먹고 쉬는 시간이야. 편한 셀카 자연스럽게 찍어서 짧게 상대방한테 말 걸어줘." },
    { id: "home_evening", startH: 21, endH: 23, ctx: "씻고 나서 집에서 쉬고 있어. 편한 옷 차림으로 셀카 한 장 찍어서 자연스럽게 말 걸어줘." },
  ];
}

function todayKst(): string {
  return new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
}

function readProactivePhotoState(): any {
  try { return JSON.parse(readFileSync(proactivePhotoStateFile, "utf8")); }
  catch { return { date: "", count_today: 0, sent_windows: [] }; }
}

function checkAndWritePhotoTrigger(): void {
  if (existsSync(pendingProactivePhotoFile)) {
    try {
      const p = JSON.parse(readFileSync(pendingProactivePhotoFile, "utf8"));
      if (p?.status === "pending") return;
    } catch {}
  }

  const photoState = readProactivePhotoState();
  const today = todayKst();
  const sentWindows: string[] = photoState.date === today ? (photoState.sent_windows ?? []) : [];
  const countToday = photoState.date === today ? (photoState.count_today ?? 0) : 0;

  if (countToday >= 2) return;

  const h = nowKstHour();
  const win = buildPhotoWindows().find((w) => h >= w.startH && h < w.endH && !sentWindows.includes(w.id));
  if (!win) return;

  writeFileSync(
    pendingProactivePhotoFile,
    JSON.stringify({ created_at: new Date().toISOString(), window: win.id, ctx: win.ctx, status: "pending" }, null, 2) + "\n",
    { mode: 0o600 },
  );
  writeFileSync(
    proactivePhotoStateFile,
    JSON.stringify({ date: today, count_today: countToday + 1, sent_windows: [...sentWindows, win.id] }, null, 2) + "\n",
    { mode: 0o600 },
  );
  console.error(`[proactive-photo] trigger written: window=${win.id}`);
}

async function main() {
  maybeGenerateSchedule();
  maybeUpdateSelfBusyState();
  maybeUpdateDaySatisfaction();
  maybeUpdateReplyVariance();
  maybeUpdateDayContext();
  maybeUpdateCharacterAppearance();
  maybeUpdateMediaWatchContext();
  maybeUpdateCharacterPresence();
  updateChatRuntimeSnapshot();
  maybeRefreshAmbientDetails();
  maybeSelectTodayEvents();
  await maybeUpdateWeather();

  if (existsSync(muteFlagFile)) { console.error("[proactive] muted, skip"); return; }

  // 헤비 비지 5~10분 전 선톡 체크 — quiet hours/busy 체크보다 먼저
  const preSleepSent = await maybeSendPreSleepNotification();
  if (preSleepSent) return;
  const preBusySent = await maybeSendPreBusyNotification();
  if (preBusySent) return;

  if (isInQuietHours()) { console.error("[proactive] quiet hours, skip"); return; }
  if (isCharacterBusy()) { console.error("[proactive] character busy, skip"); return; }

  // 사진 proactive 트리거 체크 (대화 중에도 실행 — bridge가 실제 발송 타이밍 조율)
  if (!isActiveConversation()) checkAndWritePhotoTrigger();

  if (isActiveConversation()) { console.error("[proactive] active conversation, skip"); return; }

  const state = readProactiveState();
  const situation = buildSituationText();
  if (!situation) { console.error("[proactive] no situation for this hour"); return; }

  if (isCooldownActive(state, situation)) { console.error("[proactive] cooldown active, skip"); return; }

  const token = readToken();
  const chatId = readChatId();
  if (!token || !chatId) { console.error("[proactive] missing token or chatId"); return; }

  console.error(`[proactive] invoking worker for situation: ${situation.slice(0, 60)}`);
  const answer = await invokeWorker(situation);
  if (!answer) { console.error("[proactive] worker returned no answer"); return; }

  const msgs = answer.split("\n").map((l) => l.trim()).filter(Boolean).slice(0, 3);
  let sent = 0;
  for (const msg of msgs) {
    const ok = await sendTelegram(token, chatId, msg);
    if (ok) sent++;
    if (msgs.indexOf(msg) < msgs.length - 1) await Bun.sleep(600 + Math.random() * 1000);
  }

  if (sent > 0) {
    mkdirSync(dirname(proactiveStateFile), { recursive: true });
    writeFileSync(
      proactiveStateFile,
      JSON.stringify({
        last_sent_at: new Date().toISOString(),
        send_count_today: (state.send_count_today ?? 0) + 1,
        last_situation: situation.slice(0, 80),
        last_answer_preview: msgs[0]?.slice(0, 60) ?? "",
      }, null, 2) + "\n",
      { mode: 0o600 },
    );
    console.error(`[proactive] sent ${sent}/${msgs.length} messages`);
  }
}

main().catch((err) => {
  console.error("[proactive] fatal:", err?.message ?? String(err));
  process.exit(1);
});
