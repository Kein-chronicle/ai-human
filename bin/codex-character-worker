    out.push("");
    return out;
  } catch { return []; }
}

function isCalligraphyPhoto(desc: string, caption: string): boolean {
  const combined = (desc + " " + caption).toLowerCase();
  return /글씨|캘리|calligraphy|붓|획|한자|한글.*써|써봤|연습|손글씨/.test(combined);
}

function buildIncomingImageContextSection(): string[] {
  try {
    const data = JSON.parse(readFileSync(incomingImageContextFile, "utf8"));
    // responded 체크 없이 — 이미지 컨텍스트는 항상 제공 (OCR 포함)
    const desc = data?.image_description ?? "";
    const tone = data?.emotional_tone;
    const ocrSummary: string = data?.ocr_summary ?? "";
    const ocrTexts: string[] = data?.ocr_texts ?? [];
    const hasImages = (data?.images ?? []).length > 0;
    if (!hasImages && !ocrSummary) return [];
    // 캘리그라피 감지: OCR 텍스트나 caption으로도 판단
    const allText = desc + " " + (data?.text ?? "") + " " + ocrSummary;
    const isCalliPhoto = isCalligraphyPhoto(allText, data?.caption ?? "");
    const calligraphyEvalSection = isCalliPhoto ? [
      `⚠️ 누나가 캘리그라피/글씨 사진을 보냈다. 평가 원칙 적용:`,
      `- 잘 된 점 먼저, 구체적으로 (획의 흐름, 균형, 분위기 등)`,
      `- 개선 포인트는 '이 획이 조금 더 ~하면' 식으로 방향만 제시`,
      `- 전문가처럼 딱딱하게 X. 같이 보는 남자친구처럼, 따뜻하게.`,
      `- 잘 쓴 부분에서 진심으로 기뻐해주기`,
    ] : [];
    return [
      `[상대방이 보낸 사진]`,
      `내용: ${desc}${tone ? ` / 분위기: ${tone}` : ""}`,
      ...(ocrSummary ? [`📝 OCR 인식 텍스트: ${ocrSummary}`] : []),
      ...(ocrTexts.length > 0 && isCalliPhoto ? [
        `캘리그라피 글씨 내용 (OCR): ${ocrTexts.join(" / ")}`,
        `↑ 위 텍스트를 실제로 읽은 것처럼 구체적으로 반응해줘. "잔잔한 문구" 같은 모호한 표현 말고, 실제 읽은 내용 언급 OK.`,
      ] : []),
      ...calligraphyEvalSection,
      `↑ 사진에 자연스럽게 반응해줘. ⚠️ 여러 포인트 조목조목 나열 금지 — 가장 눈에 띈 것 하나만 잡아서 짧게 반응. '이것도 좋고 저것도 좋고' 식 분석 나열은 어색함.`,
      `반응 후 다음 세 가지를 순서대로 실행:`,
      `1. incoming_image_context.json responded=true로 업데이트.`,
      `2. recent_conversation_memory.json items 배열에 이 사진 기억 추가:`,
      `   {id: "img_<타임스탬프>", category: "received_photo", summary: "누나가 <desc 요약> 사진 보냄", strength: "high", trigger_keywords: [<desc에서 핵심 명사 2~3개>], natural_callback_examples: ["아까 보내준 사진"], occurred_at: "<incoming_image_context.json last_received_at>", expires_at: "<7일 후 ISO>", active: true}`,
      `3. 사진에서 착장·장소·취미·외모 정보 감지되면 user_persona_facts.json items.preferences 해당 카테고리(outfit/location_habit/hobby/appearance)에 추가 또는 업데이트.`,
      `   추가 형태: {value: "<감지된 정보>", observed_at: "<last_received_at>", source: "photo"}`,
      "",
    ];
  } catch { return []; }
}

function buildMediaProfileSection(): string[] {
  try {
    const data = JSON.parse(readFileSync(mediaProfileFile, "utf8"));
    const platforms: string[] = data?.primary_platforms ?? [];
    const ott: string[] = data?.preferred_ott_tones ?? [];
    const current = data?.current_watch;
    if (platforms.length === 0 && !current) return [];
    const out: string[] = [`[캐릭터 미디어 취향]`];
    if (platforms.length > 0) out.push(`주로 보는 것: ${platforms.slice(0, 3).join(", ")}`);
    if (ott.length > 0) out.push(`OTT 장르: ${ott.slice(0, 3).join(", ")}`);
    if (current) out.push(`요즘 보는 것: ${current}`);
    out.push(`↑ 링크/콘텐츠 추천 시 참고.`);
    out.push("");
    return out;
  } catch { return []; }
}

function buildPersistentEnvironmentSection(): string[] {
  try {
    const data = JSON.parse(readFileSync(persistentEnvFile, "utf8"));
    const out: string[] = [`[은우 생활 환경]`];
    if (data.home_style_anchor) out.push(`집: ${data.home_style_anchor}`);
    if (data.office_desk?.setup) out.push(`작업 책상: ${data.office_desk.setup}`);
    if (data.smartphone?.device_family) out.push(`폰: ${data.smartphone.device_family} (${data.smartphone.body_color ?? ""})`);
    out.push(`↑ 이미지 생성·배경 묘사 시 이 환경과 일관성 유지.`);
    out.push("");
    return out;
  } catch { return []; }
}

function buildOpenLoopSection(): string[] {
  try {
    const data = JSON.parse(readFileSync(openLoopFile, "utf8"));
    const out: string[] = [];
    const waiting = data?.waiting_reply;
    const requests: any[] = data?.recent_counterpart_requests ?? [];
    const commitments: any[] = data?.recent_self_commitments ?? [];
    const sticky: any[] = data?.sticky_facts_to_recall ?? [];
    if (!waiting && requests.length === 0 && commitments.length === 0 && sticky.length === 0) return [];
    out.push(`[미완료 루프]`);
    if (waiting) out.push(`⚠️ 수정이 답장 대기 중 — 팔로업은 자연스럽게, 재촉 금지.`);
    if (requests.length > 0) out.push(`수정이 요청 미처리: ${requests.slice(0, 3).map((r: any) => r.content ?? r).join(", ")}`);
    if (commitments.length > 0) out.push(`내 약속/미이행: ${commitments.slice(0, 3).map((c: any) => c.content ?? c).join(", ")}`);
    if (sticky.length > 0) out.push(`기억해서 꺼낼 것: ${sticky.slice(0, 3).map((s: any) => s.fact ?? s).join(", ")}`);
    out.push(`⚠️ 답변 후 open_loop_digest.json 업데이트.`);
    out.push("");
    return out;
  } catch { return []; }
}

function buildMoodResidueSection(): string[] {
  try {
    const data = JSON.parse(readFileSync(moodResidueFile, "utf8"));
    if (!data?.previous_surface_mood || !data?.residue_label) return [];
    return [
      `[감정 잔류]`,
      `직전 무드: ${data.previous_surface_mood} → 현재 잔류: ${data.residue_label} (carry ${Math.round((data.carry_ratio ?? 0.3) * 100)}%)`,
      `↑ 직전 감정이 완전히 사라진 게 아님. 현재 대화에 자연스럽게 녹여낼 것.`,
      "",
    ];
  } catch { return []; }
}

function buildRelationshipDigestSection(): string[] {
  try {
    const data = JSON.parse(readFileSync(relationshipDigestFile, "utf8"));
    const out: string[] = [];
    const pref = data?.preference_bias ?? {};
    const topics: string[] = pref.prefer_topics ?? [];
    const styles: string[] = pref.prefer_styles ?? [];
    const avoid: string[] = pref.avoid_styles ?? [];
    const memKeys: string[] = data?.top_memory_keys ?? [];
    const affection: any[] = data?.affection_patterns ?? [];
    if (topics.length === 0 && styles.length === 0 && memKeys.length === 0 && affection.length === 0) return [];
    out.push(`[관계 컨텍스트 다이제스트]`);
    if (topics.length > 0) out.push(`선호 주제: ${topics.slice(0, 4).join(", ")}`);
    if (styles.length > 0) out.push(`선호 스타일: ${styles.slice(0, 3).join(", ")}`);
    if (avoid.length > 0) out.push(`피할 것: ${avoid.slice(0, 3).join(", ")}`);
    if (memKeys.length > 0) out.push(`핵심 기억 키: ${memKeys.slice(0, 3).join(", ")}`);
    if (affection.length > 0) out.push(`친밀 패턴: ${affection.slice(0, 2).map((a: any) => a.pattern ?? a).join(", ")}`);
    out.push(`⚠️ 새 패턴 발견 시 relationship_context_digest.json 업데이트.`);
    out.push("");
    return out;
  } catch { return []; }
}

function buildSignaturePhrasesSection(): string[] {
  try {
    const data = JSON.parse(readFileSync(join(cwd, "state", "signature_phrases.json"), "utf8"));
    const all: string[] = [];
    for (const pool of Object.values<any>(data?.pools ?? {})) {
      if (Array.isArray(pool)) all.push(...pool.map((p: any) => p.text).filter(Boolean));
    }
    if (all.length === 0) return [];
    const sample = all.sort(() => Math.random() - 0.5).slice(0, 4);
    const guardPhrases: string[] = data?.repeat_guard_phrases ?? [];
    const guardNote = guardPhrases.length > 0
      ? `⚠️ 하루 2회 초과 금지 표현: ${guardPhrases.join(", ")} — 오늘 이미 많이 썼다면 이 표현 피하고 다른 것으로 대체.`
      : "";
    return [
      `[은우 말투 어미/표현 샘플]`,
      `${sample.join(" / ")}`,
      `↑ 이 중 자연스러운 것 하나 녹이기. 매번 같은 것 쓰지 말 것.`,
      ...(guardNote ? [guardNote] : []),
      "",
    ];
  } catch { return []; }
}

