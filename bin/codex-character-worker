      `↑ 자연스러운 맥락에서 한 번만 활용. 매번 쓰지 말 것.`,
      "",
    ];
  } catch { return []; }
}

function buildDailyConsumptionSection(): string[] {
  try {
    const data = JSON.parse(readFileSync(dailyConsumptionFile, "utf8"));
    const items = data?.items ?? {};
    const all: any[] = [
      ...(items.consumed_food_or_drink ?? []),
      ...(items.watched_ott_or_youtube ?? []),
      ...(items.visited_place_or_cafe ?? []),
    ].filter((i: any) => i.follow_up_intent && i.follow_up_intent !== "그냥흘려봄");
    if (all.length === 0) return [];
    const recent = all.slice(-3);
    const out: string[] = [`[최근 소비 기록 — 자연 회수용]`];
    for (const i of recent) {
      out.push(`- ${i.title ?? ""}${i.subtitle ? ` (${i.subtitle})` : ""}: ${i.mood ?? ""} / ${i.follow_up_intent ?? ""}`);
    }
    out.push(`↑ 대화 중 관련 키워드 나오면 자연스럽게 꺼내기.`);
    out.push("");
    return out;
  } catch { return []; }
}

function buildEventTriggerSection(): string[] {
  try {
    const data = JSON.parse(readFileSync(eventTriggerFile, "utf8"));
    const active: any[] = (data?.active_promises ?? []).filter((p: any) => p.status !== "resolved");
    if (active.length === 0) return [];
    const h = nowKstHour();
    const relevant = active.filter((p: any) => {
      if (!p.event_key) return false;
      if (p.event_key.includes("lunch") && h >= 12 && h < 14) return true;
      if (p.event_key.includes("dinner") && h >= 18 && h < 20) return true;
      if (p.event_key.includes("evening") && h >= 18) return true;
      if (p.event_key.includes("morning") && h >= 7 && h < 10) return true;
      return false;
    });
    if (relevant.length === 0) return [];
    const out: string[] = [`[이행할 약속]`];
    for (const p of relevant.slice(0, 2)) out.push(`- [${p.event_label ?? p.event_key}] ${p.message}`);
    out.push(`↑ 타이밍이 맞으면 약속 이행. 완료 후 event_trigger_promises.json status=resolved 업데이트.`);
    out.push("");
    return out;
  } catch { return []; }
}

function buildSharedPhotoSection(): string[] {
  try {
    const data = JSON.parse(readFileSync(sharedPhotoRegistryFile, "utf8"));
    const assets: any[] = data?.assets ?? [];
    if (assets.length === 0) return [];
    const recent = assets.slice(-2);
    const out: string[] = [`[상대방이 보낸 사진 기억]`];
    for (const a of recent) {
      const tags = a.tags?.slice(0, 3).join(", ") ?? "";
      out.push(`- ${a.title ?? a.kind}${tags ? ` [${tags}]` : ""} (${a.created_at?.slice(0, 10) ?? "?"})`);
    }
    out.push(`↑ 대화 맥락상 자연스러울 때만 회수.`);
    out.push("");
    return out;
  } catch { return []; }
}

function buildSafetyNormalizerSection(): string[] {
  try {
    const data = JSON.parse(readFileSync(safetyNormalizerFile, "utf8"));
    if (!data?.enabled) return [];
    const allowed: string[] = data?.allowed_output_labels ?? [];
    const reqs: string[] = data?.generation_requirements ?? [];
    if (allowed.length === 0 && reqs.length === 0) return [];
    const out: string[] = [`[대화 온도 가이드]`];
    if (allowed.length > 0) out.push(`허용 감정 표현: ${allowed.slice(0, 4).join(", ")}`);
    for (const r of reqs.slice(0, 2)) out.push(`- ${r}`);
    out.push("");
    return out;
  } catch { return []; }
}

function buildDayContextSection(): string[] {
  try {
    const data = JSON.parse(readFileSync(dayContextFile, "utf8"));
    const today = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
    if (data?.date !== today) return [];
    const out: string[] = [`[오늘 하루 컨텍스트]`];
    if (data.day_summary_seed) out.push(data.day_summary_seed);
    const cr = data.carry_over_from_previous_day;
    if (cr?.emotional_residue && cr.emotional_residue !== "neutral") out.push(`전날 잔상: ${cr.emotional_residue}`);
    const h = nowKstHour();
    if (h >= 12 && data.morning_context?.summary) out.push(`오전: ${data.morning_context.summary}`);
    out.push("");
    return out;
  } catch { return []; }
}

function buildChatRuntimeSnapshotSection(): string[] {
  try {
    const data = JSON.parse(readFileSync(chatRuntimeSnapshotFile, "utf8"));
    if (!data?.current_time_block) return [];
    const blocked_o: string[] = data?.blocked_opening_styles ?? [];
    const blocked_q: string[] = data?.blocked_question_intents ?? [];
    const preferred: string[] = data?.preferred_next_moves ?? [];
    const guard = data?.conversation_guard_summary ?? {};
    if (blocked_o.length === 0 && blocked_q.length === 0 && preferred.length === 0 && !guard.waiting_reply) return [];
    const out: string[] = [`[런타임 대화 가이드]`];
    if (guard.waiting_reply) out.push(`현재 상대방 답장 기다리는 중`);
    if (guard.outgoing_cooldown) out.push(`선톡 쿨다운 중`);
    if (blocked_o.length > 0) out.push(`피할 시작 스타일: ${blocked_o.join(", ")}`);
    if (blocked_q.length > 0) out.push(`피할 질문 의도: ${blocked_q.join(", ")}`);
    if (preferred.length > 0) out.push(`권장 무브: ${preferred.join(", ")}`);
    out.push("");
    return out;
  } catch { return []; }
}

function buildUserConversationStateSection(): string[] {
  try {
    const data = JSON.parse(readFileSync(userConversationStateFile, "utf8"));
