    const contradictions: string[] = data?.mild_contradictions ?? [];
    if (dislikes.length === 0 && contradictions.length === 0) return [];
    const out: string[] = [`[캐릭터 취향 결]`];
    if (dislikes.length > 0) out.push(`미묘하게 안 맞는 것: ${dislikes.slice(0, 2).join(" / ")}`);
    if (contradictions.length > 0) out.push(`작은 모순: ${contradictions.slice(0, 2).join(" / ")}`);
