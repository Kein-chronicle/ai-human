    out.push("");
    return out;
  } catch { return []; }
}

function buildShareEventSection(): string[] {
  try {
    const ctx = JSON.parse(readFileSync(shareEventContextFile, "utf8"));
    if (!ctx?.allow_proactive_image_share) return [];
    const lastShare = ctx.last_image_share_at;
    if (lastShare) {
      const cooldownMs = (ctx.image_share_cooldown_minutes ?? 30) * 60 * 1000;
      if (Date.now() - new Date(lastShare).getTime() < cooldownMs) return [];
    }
    const events: string[] = ctx.preferred_photo_events ?? [];
    if (events.length === 0) return [];
    return [
      `[사진 공유 기회]`,
      `자연스러운 타이밍에 사진 먼저 보내도 됨: ${events.slice(0, 3).join(" / ")}`,
      `↑ 대화 흐름상 어색하지 않을 때만. 쿨다운 ${ctx.image_share_cooldown_minutes ?? 30}분.`,
      "",
    ];
  } catch { return []; }
}

function buildCalligraphyWorkShareSection(): string[] {
  try {
    const stateFile = join(cwd, "state", "calligraphy_work_state.json");
    const ws = JSON.parse(readFileSync(stateFile, "utf8"));
    const shareable = ["shareable_finished_piece", "shareable_partial_piece"].includes(ws?.share_status);
    if (!shareable) return [];
    const isFinished = ws.share_status === "shareable_finished_piece";
    const desc = ws.today_piece_description ?? "오늘 쓴 글씨";
    const context = ws.share_context ? ` (${ws.share_context})` : "";
    const shareLevel = isFinished
      ? `완성본 공유 가능 — 전체 보여줘도 됨`
      : `부분 공개 — 일부만 보여주거나 WIP 느낌으로`;
    return [
      `[캘리 작업물 공유 가능]`,
      `오늘 작업: ${desc}${context}`,
      `공개 수위: ${shareLevel}`,
      `↑ 대화 흐름이 맞으면 이 작업물 사진(image_gen — calligraphy output shot)을 먼저 공유해도 됨.`,
      `  공유 시 감정 결 필수: 오늘 한 장 마음에 들었다 / 아직 완성은 아닌데 보고 싶었다 / 이 문구 네 생각에 쓴 거다 중 상황에 맞게.`,
      `  ⚠️ 억지로 끼우지 말 것 — 대화가 작업/글씨 쪽이거나 먼저 공유할 자연스러운 타이밍일 때만.`,
      `  ⚠️ 작업 상황 변하면 ${stateFile} 업데이트: share_status/today_piece_description/date/last_updated_at.`,
      "",
    ];
  } catch { return []; }
}

function buildOutfitContextSection(): string[] {
  try {
    const presets = JSON.parse(readFileSync(outfitPresetsFile, "utf8"));
    const h = nowKstHour();
    const nowMin = h * 60 + new Date(Date.now() + 9 * 3600 * 1000).getMinutes();

    // dress_done 기준으로 잠옷/작업복 분기
    let dressDoneMin = -1;
    let departMin = -1;
    try {
      const sched = JSON.parse(readFileSync(join(cwd, "state", "daily_schedule_state.json"), "utf8"));
      const today = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
      if (sched?.date === today && sched.day_type === "weekday") {
        const dd = sched.morning?.morning_prep?.dress_done ?? "";
        const dp = ""; // 캘리그라피 작가 — 출근 없음
        if (dd) {
          const [dh, dm] = dd.split(":").map(Number);
          dressDoneMin = dh * 60 + dm;
        }
        if (dp) {
          const [ph, pm] = dp.split(":").map(Number);
          departMin = ph * 60 + pm;
        }
      }
    } catch {}

    let key = "night_home";
    if (dressDoneMin >= 0 && nowMin < dressDoneMin && h >= 6 && h < 10) {
      // 기상~옷 입기 전: 잠옷
      const preset = presets?.presets?.["night_home"];
      const overall = preset?.overall ?? "홈웨어 또는 잠옷";
      return [
        `[현재 복장] — 아침 준비 중 (아직 옷 안 갈아입음, dress_done ${Math.floor(dressDoneMin/60)}:${String(dressDoneMin%60).padStart(2,"0")} 전)`,
        overall,
        `↑ 사진 생성 시: 잠옷/홈웨어 착용 + 집 실내 배경만. 카페·길거리 등 야외 배경 금지.`,
        "",
      ];
    } else if (departMin >= 0 && dressDoneMin >= 0 && nowMin >= dressDoneMin && nowMin < departMin) {
      // 옷 갈아입음~작업 시작 전: 작업복 + 집 실내
      key = "morning_ready";
      const preset = presets?.presets?.[key];
      const overall = preset?.overall ?? "캐주얼 작업복";
      return [
        `[현재 복장] — 아침 준비 완료, 작업 시작 전`,
        overall,
        `↑ 사진 생성 시: 캐주얼 작업복 착용 + 집 실내 (작업실 또는 거실).`,
        "",
      ];
    } else {
      if (h >= 7 && h < 9) key = "morning_ready";
      else if (h >= 9 && h < 12) key = "work_morning";
      else if (h >= 12 && h < 14) key = "lunch_break";
      else if (h >= 14 && h < 18) key = "work_afternoon";
      else if (h >= 18 && h < 21) key = "evening_free_time";
      else key = "night_home";
      const preset = presets?.presets?.[key];
      if (!preset?.overall) return [];
      return [`[현재 복장]`, preset.overall, `↑ 사진 생성 시 복장 일관성 유지.`, ""];
    }
  } catch { return []; }
}

function buildPhotoSituationGuardSection(): string[] {
  return [
    "[사진_상황_일치_필수] ⚠️",
    "사진의 배경·복장이 현재 대화에서 말한 상황과 다를 때, 대화 상황을 사진에 맞춰 임의로 바꾸는 것 절대 금지.",
    "  ✗ 금지: 집에서 준비 중이라고 했는데 카페 사진 나와서 '거의 나왔어' 라고 상황 변경.",
    "  ✓ 올바른 처리: 사진이 현재 상황(집 실내)과 다르면 재생성. 대화 내용 유지.",
    "원칙: 사진이 상황을 만드는 게 아니라, 상황에 맞는 사진을 만든다.",
    "",
  ];
}

function buildImageShotHistorySection(): string[] {
  try {
    const data = JSON.parse(readFileSync(imageShotHistoryFile, "utf8"));
    const plans: any[] = data?.recent_plans ?? [];
    if (plans.length === 0) return [];
    const recent = plans.slice(-3);
    const patterns = recent.map((p: any) => [p.shot_type, p.pose, p.expression].filter(Boolean).join("/")).filter(Boolean);
    if (patterns.length === 0) return [];
    return [`[최근 사진 패턴 — 반복 금지]`, patterns.join(" | "), ""];
  } catch { return []; }
}

function buildCharacterPresenceSection(): string[] {
  try {
    const data = JSON.parse(readFileSync(characterPresenceFile, "utf8"));
    const now = new Date(Date.now() + 9 * 3600 * 1000).toISOString();
    if (data?.valid_until && now > data.valid_until) return [];
    const energy = data?.energy_level;
    const affection = data?.affection_level;
    const tempo = data?.reply_tempo;
    const mood = data?.surface_mood;
    if (!mood && !energy) return [];
    const out: string[] = [`[캐릭터 현재 상황]`];
    if (mood) out.push(`기분: ${mood}`);
    if (energy !== undefined) out.push(`에너지: ${energy}/100`);
    if (affection !== undefined) out.push(`애정: ${affection}/100`);
    if (tempo) out.push(`답장 템포: ${tempo}`);
    out.push("");
    return out;
  } catch { return []; }
}

